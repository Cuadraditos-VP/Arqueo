rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo los usuarios de esta lista pueden leer y escribir los datos del arqueo.
    // Cambiá el correo por el del usuario que creaste en Authentication (podés poner varios).
    match /arqueo/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['CORREO-DEL-USUARIO@ejemplo.com'];
    }
  }
}
